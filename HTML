<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TOOLS SON TUPANG ENTERPRISE</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',sans-serif}
body{overflow-x:hidden;background:#050816;color:#fff;min-height:100vh}
.bg{position:fixed;top:0;left:0;width:100%;height:100%;
background:linear-gradient(-45deg,#00f7ff,#0055ff,#8a2be2,#ff00ff);
background-size:400% 400%;animation:gradient 12s ease infinite;z-index:-2}
@keyframes gradient{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
.bg::before{content:"";position:absolute;width:100%;height:100%;
background-image:radial-gradient(circle,#ffffff55 1px,transparent 1px);
background-size:40px 40px;animation:moveStars 30s linear infinite}
@keyframes moveStars{from{transform:translateY(0)}to{transform:translateY(-200px)}}
header{text-align:center;padding:25px}
.logo{font-size:35px;font-weight:bold;text-shadow:0 0 15px cyan,0 0 30px cyan}
.clock{margin-top:15px;font-size:22px;font-weight:bold}
.date{font-size:16px;opacity:.8}
.dashboard{padding:20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
.card{background:rgba(255,255,255,.08);backdrop-filter:blur(12px);border-radius:20px;padding:25px;text-align:center;transition:.4s;border:1px solid rgba(255,255,255,.1)}
.card:hover{transform:translateY(-8px);box-shadow:0 0 20px cyan,0 0 40px #00f7ff}
footer{text-align:center;padding:30px;opacity:.7}
</style>
</head>
<body>
<div class="bg"></div>
<header>
<div class="logo">🚀 TOOLS SON TUPANG ENTERPRISE</div>
<div class="clock" id="clock">00:00:00</div>
<div class="date" id="date">Loading...</div>
</header>

<section class="dashboard">
<div class="card"><h2>💍 Undangan Pernikahan</h2><p>Website Pernikahan Digital</p></div>
<div class="card"><h2>🛒 Penjualan Online</h2><p>Produk, Stok dan Transaksi</p></div>
<div class="card"><h2>💰 Keuangan</h2><p>Pemasukan dan Pengeluaran</p></div>
<div class="card"><h2>📈 Investasi Saham</h2><p>Profit, Loss dan Dividen</p></div>
<div class="card"><h2>🚗 Rental Mobil</h2><p>Booking dan Jadwal Sewa</p></div>
<div class="card"><h2>🏪 POS Kasir</h2><p>Kasir dan Manajemen Stok</p></div>
<div class="card"><h2>🤖 AI Assistant</h2><p>Generator Kode dan Chat AI</p></div>
<div class="card"><h2>🔐 Login</h2><p>Firebase Authentication</p></div>
<div class="card"><h2>💎 Membership</h2><p>Basic, Pro, Enterprise</p></div>
<div class="card"><h2>💳 QRIS Payment</h2><p>Pembayaran Otomatis</p></div>
<div class="card"><h2>📱 WhatsApp Gateway</h2><p>Notifikasi Otomatis</p></div>
<div class="card"><h2>📄 PDF Export</h2><p>Export Laporan PDF</p></div>
<div class="card"><h2>🛠 Admin Panel</h2><p>Kontrol Seluruh Sistem</p></div>
<div class="card"><h2>👥 Multi User</h2><p>Admin, Member, User</p></div>
</section>

<footer>TOOLS SON TUPANG ENTERPRISE © 2026</footer>

<script>
function updateClock(){
const now=new Date();
document.getElementById("clock").innerHTML=now.toLocaleTimeString('id-ID');
document.getElementById("date").innerHTML=now.toLocaleDateString('id-ID',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
}
setInterval(updateClock,1000);
updateClock();
</script>
</body>
</html>
